# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Admin database user. Used only by the migration service.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Password of the limited application user (copilot_app) that the API uses.
APP_DB_PASSWORD=

# Ordered, comma separated chat providers. Allowed: groq, gemini, ollama, fake.
LLM_CHAIN=groq,gemini,ollama

# API key of the Groq chat provider. Leave empty until you add your own key.
GROQ_API_KEY=
# Base URL of the Groq chat API.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Chat model used against Groq. No default: set it yourself.
GROQ_MODEL=
# Set to false if the provider rejects stream_options. Empty means true.
GROQ_STREAM_USAGE=

# API key of the Gemini chat provider. Leave empty until you add your own key.
GEMINI_API_KEY=
# Base URL of the Gemini chat API (OpenAI compatible).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Chat model used against Gemini. No default: set it yourself.
GEMINI_MODEL=
# Set to false if the provider rejects stream_options. Empty means true.
GEMINI_STREAM_USAGE=

# Base URL of the local Ollama server, used for chat and embeddings.
OLLAMA_BASE_URL=http://localhost:11434
# Chat model served by Ollama. Only needed when ollama is in LLM_CHAIN.
OLLAMA_CHAT_MODEL=

# Embedding provider. One of: ollama, gemini, fake.
EMBEDDING_PROVIDER=ollama
# Embedding model name recorded on every chunk and in embedding_index_meta.
EMBEDDING_MODEL=nomic-embed-text
# Vector size of the embedding model, in dimensions.
EMBEDDING_DIMENSIONS=768

# Timeout of one LLM HTTP request, in seconds. The connect timeout is 5 seconds.
LLM_TIMEOUT_SECONDS=60
# Seconds a provider is skipped after a quota or auth failure.
LLM_COOLDOWN_SECONDS=60

# Minimum dense similarity of the best chunk before the model is asked.
# A lower best score makes the assistant refuse with no model call.
# Default is 0.55; to be calibrated with python -m src.eval.calibrate.
RETRIEVAL_MIN_SIMILARITY=0.55
